(
  source: "https://github.com/S2outh/south-common",
  provider: (
    id: "south-nats",
    label: "South NATS TM/TC server",
    source_kind: "nats",
    connection: (
      url: "ws://nats.lan"
    ),
  ),
  stream_metadata: (
    format: "cbor",
    capacity: 2000,
  ),
  types: {
    "u8": (telemetry_type: "number"),
    "u16": (telemetry_type: "number"),
    "u32": (telemetry_type: "number"),
    "u64": (telemetry_type: "number"),
    "u128": (telemetry_type: "number"),
    "usize": (telemetry_type: "number"),

    "i8": (telemetry_type: "number"),
    "i16": (telemetry_type: "number"),
    "i32": (telemetry_type: "number"),
    "i64": (telemetry_type: "number"),
    "i128": (telemetry_type: "number"),
    "isize": (telemetry_type: "number"),

    "f32": (telemetry_type: "number"),
    "f64": (telemetry_type: "number"),

    "Vector2<f32>": (telemetry_type: "vector", vector_keys: Some(["x", "y"])),
    "Vector2<f64>": (telemetry_type: "vector", vector_keys: Some(["x", "y"])),
    "Vector3<f32>": (telemetry_type: "vector", vector_keys: Some(["x", "y", "z"])),
    "Vector3<f64>": (telemetry_type: "vector", vector_keys: Some(["x", "y", "z"])),

    "Quaternion<f32>": (telemetry_type: "vector", vector_keys: Some(["x", "y", "z", "w"])),
    "Quaternion<f64>": (telemetry_type: "vector", vector_keys: Some(["x", "y", "z", "w"])),

    "LLH": (telemetry_type: "vector", vector_keys: Some(["lat", "lon", "alt"])),

    "SourceEnabledKeyValue": (telemetry_type: "flags", flag_names: Some(["BAT_1", "BAT_2", "AUX_PWR"])),
    "SinkEnabledKeyValue": (telemetry_type: "flags", flag_names: Some(["CARRIER", "UMBILICAL", "ROCKET_LST_1", "ROCKET_LST_2", "SENSOR_LOWER", "ROCKET_H_D", "BACKUP_SINK"])),
    "StateFlagsKeyValue": (telemetry_type: "flags", flag_names: Some(["ARMD_A", "FIRE_A", "ARMD_B", "FIRE_B"])),

    "()": (telemetry_type: "empty"),

    "Telecommand": (telemetry_type: "object"),
    "Command": (telemetry_type: "object"),
    "State": (telemetry_type: "object"),
    "Timesync": (telemetry_type: "object"),
  },
  parsers: {
    "number": "cbor-timestamped-number",
    "vector": "cbor-timestamped-vector",
    "flags": "cbor-timestamped-flags",
    "empty": "cbor-timestamped-empty",
    "object": "cbor-timestamped-object",
  },
)
